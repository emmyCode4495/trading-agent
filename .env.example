# --- Manual watchlist (comma separated) — optional secondary drill-down,
# NOT the input to the autonomous scanner. Used as the default symbol for a
# direct lookup when no scan has run yet. ---
SYMBOLS=BTC/USDT

# --- Data source: "mock" (default, zero setup, synthetic prices) or a real
# exchange for actual live prices. Individual exchanges: "binance", "bybit",
# "mexc". Or "auto" (RECOMMENDED for real use) to try them in priority order
# and automatically fail over if one is unreachable. ---
DATA_SOURCE=mock

# Order to try exchanges in when DATA_SOURCE=auto. Bybit and MEXC are listed
# first because, as of this writing, neither is among the exchanges named in
# Nigeria's 2024 NCC directive (Binance, Coinbase, Kraken specifically) — so
# they're more likely reachable without a VPN in affected regions. Adjust
# the order/list for your own situation.
DATA_SOURCE_PRIORITY=bybit,mexc,binance

# --- Autonomous scanner: discover -> screen -> analyze -> rank ---
SCAN_QUOTE_ASSET=USDT
SCAN_MIN_QUOTE_VOLUME_24H=5000000
SCAN_MAX_SYMBOLS_TO_ANALYZE=15
SCAN_TOP_N_OPPORTUNITIES=5

# --- Storage: SQLite by default. Swap for Postgres/Timescale in production. ---
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/trading_agent

# --- LLM (news/sentiment agent only — every numeric agent is pure Python) ---
ENABLE_LLM_AGENTS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scheduling ---
# Full market scan (discover -> screen -> analyze -> rank): the expensive
# cycle. 15 min keeps it feeling continuous while respecting exchange rate
# limits for a few dozen symbols.
RUN_INTERVAL_MINUTES=15
# Position monitoring (checking OPEN recommendations against target/
# invalidation): cheap, one price lookup per open position — runs far more
# often, which is what makes the win rate update in real time.
POSITION_CHECK_INTERVAL_MINUTES=2
# A position that never reaches target or invalidation within this many
# hours is marked "expired" rather than sitting open forever.
POSITION_EXPIRY_HOURS=48

# Set to "false" to disable the in-process background scanner (e.g. if
# you're running `python -m app.scheduler` as a separate process instead,
# or only want scans triggered manually via the RUN SCAN button).
ENABLE_BACKGROUND_SCANNER=true

# --- Risk thresholds ---
MAX_VOLATILITY_PCT=6.0
MIN_CONFIDENCE_TO_ACT=60

# --- Web server ---
HOST=0.0.0.0
PORT=8000
